# ─────────────────────────────────────────────────────────────
# Viajecito — variables de entorno
# ─────────────────────────────────────────────────────────────
# Copiá este archivo como `.env.local` y completá los valores.
# `.env.local` está en .gitignore: NUNCA se sube al repo.
#
# De dónde salen estos valores:
# En Supabase Cloud -> tu proyecto -> Project Settings -> API
# ─────────────────────────────────────────────────────────────

# URL pública de tu proyecto Supabase. Es pública, viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Clave "anon" (pública). Es segura de exponer en el cliente PORQUE
# el aislamiento de datos lo hace Row Level Security en la base, no la clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_KEY"

# Clave "service_role" (SECRETA). Saltea RLS por completo.
# SOLO se usa en el servidor (Route Handlers / Server Actions).
# NUNCA la prefijes con NEXT_PUBLIC_ ni la uses en componentes de cliente.
# La vamos a necesitar recién en fases posteriores (ej: tokens de Calendar).
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"

# URL base de la app (para callbacks de OAuth). En local es esto;
# en Vercel se setea con la URL del deploy.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
